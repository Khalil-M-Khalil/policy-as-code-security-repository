{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Khalil-M-Khalil/policy-as-code-repository/policy.schema.json",
  "title": "Policy-as-Code document",
  "type": "object",
  "required": ["policy_id", "title", "version", "status", "owner", "review_cadence", "effective_date", "scope", "principles", "requirements", "exceptions", "references"],
  "properties": {
    "policy_id": {"type": "string", "pattern": "^POL-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 10},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "approved", "retired"]},
    "owner": {"type": "string", "minLength": 3},
    "approver": {"type": "string", "minLength": 3},
    "review_cadence": {"enum": ["quarterly", "semiannual", "annual"]},
    "effective_date": {"type": "string", "format": "date"},
    "scope": {"type": "string", "minLength": 30},
    "principles": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 20}},
    "requirements": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/requirement"}},
    "exceptions": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/exception"}},
    "references": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/reference"}}
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "statement", "control_mappings", "evidence", "accountable_role"],
      "properties": {
        "id": {"type": "string", "pattern": "^REQ-[0-9]{3}$"},
        "statement": {"type": "string", "minLength": 30},
        "control_mappings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "accountable_role": {"type": "string", "minLength": 3}
      }
    },
    "exception": {
      "type": "object",
      "required": ["id", "required_approver", "expiry_days", "compensating_control"],
      "properties": {
        "id": {"type": "string"},
        "required_approver": {"type": "string"},
        "expiry_days": {"type": "integer", "minimum": 1, "maximum": 365},
        "compensating_control": {"type": "string", "minLength": 20}
      }
    },
    "reference": {
      "type": "object",
      "required": ["framework", "identifier", "url"],
      "properties": {
        "framework": {"type": "string"},
        "identifier": {"type": "string"},
        "url": {"type": "string", "format": "uri"}
      }
    }
  }
}
